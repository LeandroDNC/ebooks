        },
        {
          "type": "text",
          "text": "Oração do dia",
          "font": "Cormorant Garamond",
          "size": 6,
          "color": "#344E41",
          "align": "center",
          "bold": true
        },
        {
          "type": "text",
          "text": "Deus de paz, eu entrego a ti cada preocupação. Guarda o meu coração e os meus pensamentos em Cristo Jesus. Amém.",
          "font": "Manrope",
          "size": 3.8,
          "color": "#344E41",
          "align": "left",
          "italic": true
        }
      ]
