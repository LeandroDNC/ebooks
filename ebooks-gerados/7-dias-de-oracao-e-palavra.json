          "size": 6,
          "color": "#344E41",
          "align": "center",
          "bold": true
        },
        {
          "type": "text",
          "text": "Senhor, ensina-me a orar. Que o meu coração te procure com sinceridade, longe do barulho e das aparências. Amém.",
          "font": "Manrope",
          "size": 3.8,
          "color": "#344E41",
          "align": "left",
          "italic": true
        }
      ]
    },
